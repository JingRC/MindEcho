# Normalize line endings in repo to LF
* text=auto eol=lf

# Preserve for binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.wav binary
*.flac binary
*.mp3 binary
*.ogg binary
*.opus binary
*.m4a binary
*.aiff binary
*.wv binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.pyd binary
*.so binary
*.pdf binary
# Keep shell/batch scripts with Windows endings on checkout
*.bat eol=crlf
*.cmd eol=crlf
*.pt filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
