    def update_frequency_mode(self, times, pitches, confidences):
        """频率曲线模式"""
        self.pitch_line.set_color('#00AAFF')
        self.pitch_line.set_linewidth(self.current_linewidth)  # 使用用户设置的线条粗细
        
