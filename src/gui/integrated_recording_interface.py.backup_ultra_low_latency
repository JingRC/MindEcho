                        print(f"   ⚙️ 无降噪处理，音频数据直接传递")
                else:
                    self._no_denoise_counter = 1
                    print(f"🔇 降噪模式初始化: {noise_mode}")
                
                # 保持processed_audio指向原始数据
                processed_audio = audio_data
            
            # 🎯 单一音高检测：只调用一次 detect_pitch_with_vibrato
            frequency = self.detect_pitch_with_vibrato(processed_audio)
            
            # 🔥 添加音频处理效果对比调试信息
            if hasattr(self, '_audio_compare_counter'):
                self._audio_compare_counter += 1
