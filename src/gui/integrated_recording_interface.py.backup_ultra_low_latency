    def get_main_window(self):
        """获取主窗口的引用"""
        try:
            # 遍历父对象查找主窗口
            parent = self.parent()
            while parent:
                if isinstance(parent, QMainWindow):
                    return parent
                parent = parent.parent()
            return None
        except Exception as e:
            print(f"❌ 获取主窗口失败: {e}")
