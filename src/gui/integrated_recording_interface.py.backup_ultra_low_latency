                    booster = self.intelligent_volume_booster
                    manual_volume = booster.get('manual_volume', 1.0)
                    manual_enabled = booster.get('manual_control_enabled', False)
                    
                    print(f"🎤 超稳定智能音量增强已启用:")
                    print(f"   ├─ 自动增益: 1.0x - {booster['max_gain']:.1f}x (0 - {20*np.log10(booster['max_gain']):.1f}dB)")
                    print(f"   ├─ 手动音量: {manual_volume*100:.0f}% {'(已启用)' if manual_enabled else '(未启用)'}")
                    print(f"   ├─ 目标水平: {booster['target_level']:.3f} (保守设置)")
                    print(f"   ├─ 稳定性: 变化限制{booster['gain_change_limit']:.3f}x, 缓冲区{booster['stability_buffer']:.3f}")
                    print(f"   ├─ 平滑系数: {booster['gain_smoothing']:.3f} (超高稳定性)")
                    print(f"   └─ 策略: 自适应增益 + 手动音量控制 + 突变抑制")
                else:
                    print("🎤 智能音量增强已禁用")
                
                # ⚡ 动态初始化专业监听状态
                self.frame_counter = 0
                self.latency_timestamps = []
                self.processing_times = []
                
                # � 电流音检测器（专业级）
                self.electric_noise_detector = {
                    'enabled': True,
                    'consecutive_count': 0,
                    'threshold': 0.0008
                }
                
                # 🚀 四级智能音频流配置（渐进兼容性 + 自动降级）
                audio_configs = [
                    # 第一优先级：ASIO专业驱动 + 96kHz + 16样本（理想配置）
                    {
                        'name': 'ASIO专业驱动',
                        'rate': optimized_sample_rate,
