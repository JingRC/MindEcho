                        'settings': sd.AsioSettings(channel_selectors=[0]),
                        'latency': 'low'
                    },
                    # 第二优先级：DirectSound + 48kHz + 32样本（常见兼容）
                    {
                        'name': 'DirectSound驱动',
                        'rate': 48000,
                        'block': 32,
                        'settings': None,
                        'latency': 'low'
                    },
                    # 第三优先级：标准兼容 + 44.1kHz + 64样本（广泛兼容）
                    {
                        'name': '标准兼容模式',
                        'rate': 44100,
                        'block': 64,
                        'settings': None,
                        'latency': 'low'
                    },
                    # 第四优先级：安全模式 + 44.1kHz + 128样本（最大兼容）
                    {
                        'name': '安全兼容模式',
                        'rate': 44100,
                        'block': 128,
                        'settings': None,
                        'latency': None
                    }
                ]
                
                audio_stream_started = False
                for i, config in enumerate(audio_configs):
                    try:
                        # 构建流参数
                        stream_params = {
                            'channels': self.channels,
                            'samplerate': config['rate'],
                            'blocksize': config['block'],
                            'callback': professional_monitoring_callback,
