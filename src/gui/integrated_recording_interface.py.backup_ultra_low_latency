                        try:
                            line_collection._linewidths = linewidth
                        except:
                            pass
        
        # 立即刷新显示
        if hasattr(self, 'canvas'):
            self.canvas.draw_idle()
        
        print(f"✅ 线条粗细已更新为: {linewidth:.1f}px")
    
